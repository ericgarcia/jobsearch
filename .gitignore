node_modules/
dist/
.env
.env.local
*.log

# Playwright MCP writes page snapshots and console logs next to wherever the
# server was started. They are test debris, not source.
.playwright-mcp/

# Personal data must never land in a public repo.
data/
*.db
*.db-journal
*.sqlite
resumes/
cover-letters/
profile.local.*
.jobsearch/

# The layout engine compiles into its package, like the server does.
packages/*/dist/

# Worktrees the desktop app creates for other sessions. They are checkouts of
# this same repository; committing one as a gitlink would point at a commit
# nobody else has.
.claude/worktrees/
