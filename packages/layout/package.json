{
  "name": "@jobsearch/layout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ]
}
