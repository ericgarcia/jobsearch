{
  "name": "@jobsearch/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "JOBSEARCH_DATA_DIR=$(mktemp -d) tsx test/factcheck.test.mts && tsx test/location.test.mts && tsx test/location-sql.test.mts && tsx test/tokens.test.mts && tsx test/pdf.test.mts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@anthropic-ai/claude-code": "2.1.325",
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.11",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/mcp": "0.0.85",
    "fastify": "^5.4.0",
    "zod": "^4.1.5",
    "@jobsearch/layout": "*",
    "playwright-core": "1.66.0-alpha-2026-11-09"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
